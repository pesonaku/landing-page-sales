# Supabase Configuration
# Dapatkan nilai ini dari Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Wajib untuk Webhook Midtrans agar bisa update profile bypass RLS)
# Dapatkan dari Dashboard Supabase -> Project Settings -> API -> Project API Keys -> service_role (Secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Akun Super Admin (bisa lebih dari satu, pisahkan dengan koma)
NEXT_PUBLIC_ADMIN_EMAIL=admin@domain.com,owner@domain.com

# Midtrans Configuration (Payment Gateway)
# Dapatkan dari Dashboard Midtrans -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
